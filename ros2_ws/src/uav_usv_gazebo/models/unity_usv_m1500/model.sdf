<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.10">
  <!-- Product vehicle visuals restored to physical 1:1 scale -->
  <!--
    Geometry is kept in the same vehicle-local ENU frame as
    SimulationBootstrap.BuildUsv in Unity:
      x forward, y port, z up.
    Unity renders vehicles outside the 0.18 environment root scale. Gazebo
    therefore magnifies visuals by 1 / 0.18 = 5.555555556 so the on-screen
    ratio to the friendly / enemy ships is identical to Unity.
    Visual envelope: 8.333333 x 6.111111 x 3.333333 m.
    Collision envelope matches RuntimeCollisionSafety: 1.50 x 1.10 x 0.54 m.
    Sensors, inertia and control geometry remain at physical 1:1 scale.
  -->
  <model name="unity_usv_m1500">
    <static>false</static>
    <link name="hull">
      <gravity>false</gravity>
      <enable_wind>true</enable_wind>
      <inertial>
        <mass>35.0</mass>
        <inertia>
          <ixx>4.58</ixx>
          <iyy>7.61</iyy>
          <izz>10.09</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="vehicle_envelope">
        <pose>0 0 0.27 0 0 0</pose>
        <geometry>
          <box>
            <size>1.50 1.10 0.54</size>
          </box>
        </geometry>
      </collision>
      <visual name="port_pontoon_lower">
        <pose>-0.1699999999 0.3900000001 0.01999999998 0 0 0</pose>
        <geometry>
          <box>
            <size>1.16 0.3000000001 0.2</size>

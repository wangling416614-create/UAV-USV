<?xml version="1.0"?>
<sdf version="1.10">
  <model name="sim332_usv_green">
    <include merge="true"><uri>model://unity_usv_m1500</uri></include>
    <plugin filename="libBoatWaveFollower.so" name="gz::sim::systems::BoatWaveFollower">
      <mean_z>0.0</mean_z><heave_amplitude>0.02</heave_amplitude>
      <roll_amplitude>0.025</roll_amplitude><pitch_amplitude>0.018</pitch_amplitude>
      <primary_frequency>1.1</primary_frequency><secondary_frequency>1.7</secondary_frequency>
      <wave_number_x>0.35</wave_number_x><wave_number_y>0.22</wave_number_y>
      <velocity_topic>/model/own_02/cmd_vel</velocity_topic>
    </plugin>
  </model>
</sdf>
